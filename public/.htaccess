# Apache: el document root debe apuntar a esta carpeta (public/).
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Bloquear archivos ocultos (.env, .git, .htaccess…)
  RewriteRule "(^|/)\." - [F]
  # Todo lo que no sea un archivo existente pasa por el front controller
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
