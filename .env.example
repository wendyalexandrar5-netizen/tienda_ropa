# =============================================================================
# FIRE CAT · Variables de entorno
# Copia este archivo como .env y completa los valores. NUNCA subas .env al
# repositorio (está en .gitignore). Las claves secretas solo viven en el
# servidor backend; el navegador y la app móvil nunca las reciben.
# =============================================================================

# --- Aplicación --------------------------------------------------------------
APP_ENV=production            # production | local
APP_DEBUG=false               # true solo en desarrollo (muestra detalles de errores)
APP_URL=https://tu-dominio.com
APP_NAME="FIRE CAT"

# --- Supabase ----------------------------------------------------------------
# Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publicable (sb_publishable_... o la legacy "anon"). Es pública, pero
# solo es segura porque TODAS las tablas tienen RLS.
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_... o legacy "service_role"). SOLO backend/scripts.
# La aplicación web no la necesita en tiempo de ejecución; se usa en
# scripts/seed_demo.php para crear usuarios de prueba.
SUPABASE_SECRET_KEY=
# Solo si el proyecto usa el "Legacy JWT secret" (HS256). Con claves de firma
# asimétricas (ES256/RS256, recomendado) déjalo vacío: se usa el JWKS.
SUPABASE_JWT_SECRET=
# Opcionales (se derivan de SUPABASE_URL):
# SUPABASE_AUTH_URL=https://TU-PROYECTO.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://TU-PROYECTO.supabase.co/auth/v1/.well-known/jwks.json

# --- PostgreSQL (Supabase) ---------------------------------------------------
# Project Settings → Database → Connection string (Session pooler, puerto 5432)
# Con el Transaction pooler (6543) activa DB_EMULATE_PREPARES=true.
DATABASE_URL=postgresql://postgres.TU-PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_EMULATE_PREPARES=false

# --- Almacenamiento de imágenes ---------------------------------------------
STORAGE_DRIVER=supabase       # supabase | local (public/uploads, solo desarrollo)
STORAGE_BUCKET=productos
UPLOAD_MAX_BYTES=5242880      # 5 MB

# --- Seguridad ---------------------------------------------------------------
COOKIE_SECURE=true            # true en producción (HTTPS)
SESSION_LIFETIME=604800       # segundos (7 días)
RATE_LIMIT_ENABLED=true
TRUST_PROXY=false             # true si hay un proxy/CDN que envía X-Forwarded-For
# Orígenes adicionales autorizados a consumir la API vía CORS (con Bearer token)
CORS_ALLOWED_ORIGINS=
