# Las imágenes subidas NUNCA se ejecutan como código.
# Versión compatible con hosting compartido (InfinityFree): no usa Options,
# RemoveHandler ni RemoveType, que ese tipo de hosting no permite.
# Sólo se permiten imágenes; cualquier otro archivo se bloquea.
<FilesMatch "\.(?i:php\d?|phtml|phar|pht|phps|cgi|pl|py|sh|htaccess|html?|svg|js)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
