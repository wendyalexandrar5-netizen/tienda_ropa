# FIRE CAT · Configuración de Apache (XAMPP)
Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

# Archivos sensibles: script SQL, documentación interna, archivos ocultos y de configuración
<FilesMatch "(^\.|\.(sql|md|log|ini|sh|lock|bak|dist)$|^config\.local.*\.php$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Carpetas internas que nunca deben servirse directamente
    RewriteRule ^(config|includes|storage|tests|docs|admin/includes|proyecto_original)(/|$) - [F,L]
</IfModule>

ErrorDocument 403 "Acceso denegado"

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag expose_php Off
    php_value upload_max_filesize 3M
    php_value post_max_size 8M
</IfModule>
